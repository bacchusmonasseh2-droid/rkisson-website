---
/**
 * Responsive, optimised image.
 * `name` is a file name (without extension) in src/assets/img/.
 * Astro generates AVIF/WebP at several widths at build time.
 */
import { Picture as AstroPicture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  alt: string;
  sizes?: string;
  widths?: number[];
  loading?: 'lazy' | 'eager';
  class?: string;
}

const {
  name,
  alt,
  sizes = '(min-width: 1100px) 600px, (min-width: 720px) 50vw, 100vw',
  widths = [480, 800, 1200, 1600],
  loading = 'lazy',
  class: className,
} = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>('../assets/img/*.{jpg,jpeg,png,webp}', {
  eager: true,
});
const match = Object.entries(images).find(([path]) => path.split('/').pop()!.split('.')[0] === name);
if (!match) throw new Error(`Image "${name}" not found in src/assets/img/`);
const src = match[1].default;
const usable = widths.filter((w) => w <= src.width);
---

<AstroPicture
  src={src}
  alt={alt}
  formats={['avif', 'webp']}
  fallbackFormat="jpg"
  widths={usable.length ? usable : [src.width]}
  sizes={sizes}
  loading={loading}
  decoding={loading === 'eager' ? 'sync' : 'async'}
  fetchpriority={loading === 'eager' ? 'high' : undefined}
  quality={72}
  class={className}
/>
