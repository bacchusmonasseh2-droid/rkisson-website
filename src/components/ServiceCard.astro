---
import type { Service } from '../data/services';
import Picture from './Picture.astro';
import Icon from './Icon.astro';

interface Props {
  service: Service;
  delay?: number;
}
const { service, delay = 0 } = Astro.props;
const href = service.slug === 'equipment-rental' ? '/equipment-rental/' : `/services/${service.slug}/`;
---

<a class="service-card" href={href} data-reveal style={`--delay:${delay}s`}>
  <div class="service-card__media">
    <Picture name={service.image} alt="" sizes="(min-width: 1100px) 400px, (min-width: 720px) 50vw, 100vw" widths={[400, 640, 900]} />
    <span class="service-card__no">{service.number}</span>
  </div>
  <div class="service-card__body">
    <h3>{service.title}</h3>
    <p>{service.summary}</p>
    <span class="service-card__more">
      View service
      <Icon name="arrow" />
    </span>
  </div>
</a>
