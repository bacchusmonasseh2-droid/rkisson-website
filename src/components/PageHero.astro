---
import Picture from './Picture.astro';

interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  label: string;
  title: string;
  lead?: string;
  image?: string;
  crumbs?: Crumb[];
}
const { label, title, lead, image, crumbs = [] } = Astro.props;
---

<section class:list={['page-hero', { 'page-hero--plain': !image }]}>
  {
    image && (
      <div class="page-hero__media">
        <Picture name={image} alt="" sizes="100vw" widths={[640, 1024, 1600, 2048]} loading="eager" />
      </div>
    )
  }
  <div class="wrap on-dark">
    {
      crumbs.length > 0 && (
        <nav aria-label="Breadcrumb">
          <ol class="crumbs" style="list-style:none;padding:0;margin-top:0">
            <li>
              <a href="/">Home</a>
            </li>
            {crumbs.map((c) => (
              <li aria-current={c.href ? undefined : 'page'}>{c.href ? <a href={c.href}>{c.label}</a> : c.label}</li>
            ))}
          </ol>
        </nav>
      )
    }
    <p class="label">{label}</p>
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>
