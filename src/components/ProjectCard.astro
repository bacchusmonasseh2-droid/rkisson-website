---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { categoryLabels, showValues, statusLabels, type Project } from '../data/projects';

interface Props {
  project: Project;
  compact?: boolean;
}
const { project, compact = false } = Astro.props;

// Genuine project photographs live in src/assets/projects/ (see README).
const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/projects/*.{jpg,jpeg,png,webp}', {
  eager: true,
});
const photo = project.photo
  ? Object.entries(photos).find(([p]) => p.endsWith(`/${project.photo}`))?.[1].default
  : undefined;
---

<article class="project-card" data-categories={project.categories.join(' ')} data-status={project.status}>
  {
    photo && (
      <div class="project-card__photo">
        <Image src={photo} alt={`${project.title}, ${project.location}`} widths={[400, 800]} sizes="(min-width: 1100px) 400px, 100vw" />
      </div>
    )
  }
  <div class="project-card__head">
    <span>{project.categories.map((c) => categoryLabels[c]).join(' · ')}</span>
    <span class={`status status--${project.status}`}>{statusLabels[project.status]}</span>
  </div>
  <div class="project-card__body">
    <h3>{project.title}</h3>
    <p>{project.description}</p>
    {
      !compact && project.scope && (
        <ul class="project-card__scope">
          {project.scope.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      )
    }
    <dl class="meta">
      <dt>Client</dt>
      <dd>{project.client}</dd>
      <dt>Location</dt>
      <dd>{project.region ? `${project.location}, ${project.region}` : project.location}</dd>
      <dt>{project.dateLabel}</dt>
      <dd>{project.date}</dd>
      {
        showValues && project.value && (
          <>
            <dt>Value</dt>
            <dd>{project.value}</dd>
          </>
        )
      }
      <dt>Source</dt>
      <dd>
        <a href={project.source.url} rel="noopener nofollow" target="_blank">
          {project.source.label}
          <span class="sr-only"> (opens in a new tab)</span>
        </a>
      </dd>
    </dl>
  </div>
</article>
