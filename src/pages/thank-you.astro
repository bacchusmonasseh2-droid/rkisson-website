---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { company } from '../data/company';
---

<Base title="Request received" description="Thank you. Your quotation request has been received by R. Kissoon Contracting Service." noindex>
  <PageHero
    label="Thank you"
    title="Your request has been received."
    lead="We will review the details and reply using the contact information you provided. If your enquiry is urgent, please call the office."
  >
    <p style="margin-top:2rem;display:flex;flex-wrap:wrap;gap:.9rem">
      <a class="btn btn--primary" href="/">
        Back to home
        <Icon name="arrow" />
      </a>
      <a class="btn btn--ghost" href={`tel:${company.phones[0].tel}`}>{company.phones[0].display}</a>
    </p>
  </PageHero>
</Base>
