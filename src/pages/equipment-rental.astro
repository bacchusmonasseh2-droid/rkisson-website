---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Picture from '../components/Picture.astro';
import Icon from '../components/Icon.astro';
import CTA from '../components/CTA.astro';
import { equipment } from '../data/equipment';
import { getService } from '../data/services';

const service = getService('equipment-rental');
const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/equipment/*.{jpg,jpeg,png,webp}', {
  eager: true,
});
const photoFor = (file?: string) =>
  file ? Object.entries(photos).find(([p]) => p.endsWith(`/${file}`))?.[1].default : undefined;
const enquiryHref = '/contact/?service=equipment-rental#quote';
---

<Base title="Construction Equipment Rental" description={service.metaDescription}>
  <PageHero
    label="Service 06"
    title="Construction equipment rental."
    lead="Tell us the machine you need, where and for how long. We will confirm availability and terms."
    image="equipment"
    crumbs={[{ label: 'Equipment Rental' }]}
  >
    <p style="margin-top:2rem">
      <a class="btn btn--primary" href={enquiryHref}>
        Make a rental enquiry
        <Icon name="arrow" />
      </a>
    </p>
  </PageHero>

  <section class="section">
    <div class="wrap grid-2 grid-2--wide-left">
      <div class="prose" data-reveal>
        <p class="label">Overview</p>
        <h2>Machinery when the job needs it.</h2>
        <p class="lead">{service.intro}</p>
        {service.involves.map((p) => <p>{p}</p>)}
      </div>
      <aside data-reveal style="--delay:.12s">
        <p class="label">Who rents from us</p>
        <ul class="ticks">
          {service.clients.map((c) => <li>{c}</li>)}
        </ul>
      </aside>
    </div>
  </section>

  <section class="section section--concrete" aria-labelledby="fleet-heading">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="label">Equipment</p>
        <h2 id="fleet-heading">{equipment.length > 0 ? 'Available for rental.' : 'Availability on request.'}</h2>
      </div>

      {
        equipment.length > 0 ? (
          <div class="equip-grid">
            {equipment.map((item) => {
              const photo = photoFor(item.photo);
              return (
                <article class="equip-card" data-reveal>
                  {photo && <Image src={photo} alt={item.name} widths={[400, 800]} sizes="(min-width: 1100px) 400px, 100vw" />}
                  <div class="equip-card__body">
                    <h3>{item.name}</h3>
                    <p>{item.description}</p>
                    <dl class="meta">
                      {item.specifications.map((s) => (
                        <>
                          <dt>{s.label}</dt>
                          <dd>{s.value}</dd>
                        </>
                      ))}
                      <dt>Availability</dt>
                      <dd>{item.availability}</dd>
                    </dl>
                    <a class="text-link" href={`${enquiryHref}`} style="justify-self:start">
                      Enquire about this machine
                      <Icon name="arrow" />
                    </a>
                  </div>
                </article>
              );
            })}
          </div>
        ) : (
          <div class="grid-2" data-reveal>
            <div class="prose">
              <p>
                An equipment list has not yet been published on this page. Contact us with your requirement and we
                will tell you what we can offer for your dates.
              </p>
              <p>
                <a class="btn btn--navy" href={enquiryHref}>
                  Make a rental enquiry
                  <Icon name="arrow" />
                </a>
              </p>
            </div>
            <figure class="frame">
              <Picture
                name="equipment"
                alt="Illustrative image of construction machinery parked in a yard"
                sizes="(min-width: 900px) 45vw, 100vw"
              />
              <figcaption>Illustrative image. Does not depict the company’s equipment.</figcaption>
            </figure>
          </div>
        )
      }
    </div>
  </section>

  <section class="section" aria-labelledby="how-heading">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="label">How it works</p>
        <h2 id="how-heading">Making a rental enquiry.</h2>
      </div>
      <div class="steps">
        <div class="step" data-reveal>
          <h3>Tell us what you need</h3>
          <p>The type of machine, the work it will do, the site location and the dates you need it for.</p>
        </div>
        <div class="step" data-reveal style="--delay:.08s">
          <h3>We confirm availability</h3>
          <p>We check our schedule and reply with what is available, the rental terms and transport arrangements.</p>
        </div>
        <div class="step" data-reveal style="--delay:.16s">
          <h3>Agree and mobilise</h3>
          <p>Once terms are agreed, the equipment is delivered to site or made ready for collection.</p>
        </div>
      </div>
    </div>
  </section>

  <CTA heading={service.cta.heading} text={service.cta.text} button={service.cta.button} href={enquiryHref} />
</Base>
