---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Picture from '../../components/Picture.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Icon from '../../components/Icon.astro';
import CTA from '../../components/CTA.astro';
import { services, type Service } from '../../data/services';
import { sortedProjects } from '../../data/projects';
import { company } from '../../data/company';

export function getStaticPaths() {
  // Equipment rental has its own dedicated page at /equipment-rental/.
  return services
    .filter((s) => s.slug !== 'equipment-rental')
    .map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

interface Props {
  service: Service;
}
const { service } = Astro.props;
const related = sortedProjects
  .filter((p) => p.categories.some((c) => service.projectCategories.includes(c)))
  .slice(0, 3);
const others = services.filter((s) => s.slug !== service.slug);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: service.title,
    description: service.summary,
    areaServed: { '@type': 'Country', name: 'Guyana' },
    provider: { '@type': 'GeneralContractor', name: company.name },
  },
];
---

<Base title={service.navTitle} description={service.metaDescription} schema={schema}>
  <PageHero
    label={`Service ${service.number}`}
    title={service.title}
    lead={service.summary}
    image={service.image}
    crumbs={[{ label: 'Services', href: '/services/' }, { label: service.navTitle }]}
  />

  <section class="section">
    <div class="wrap grid-2 grid-2--wide-left">
      <div class="prose" data-reveal>
        <p class="label">Overview</p>
        <h2>What the work involves</h2>
        <p class="lead">{service.intro}</p>
        {service.involves.map((p) => <p>{p}</p>)}
        {
          service.record && (
            <div class="record">
              <p class="label">Documented experience</p>
              <p>{service.record}</p>
            </div>
          )
        }
      </div>
      <aside data-reveal style="--delay:.12s" aria-labelledby="scope-heading">
        <p class="label">Scope</p>
        <h3 id="scope-heading" style="margin-bottom:1.25rem">Services in this category</h3>
        <ul class="ticks">
          {service.scope.map((item) => <li>{item}</li>)}
        </ul>
        <p style="margin-top:2rem">
          <a class="btn btn--navy" href={`/contact/?service=${service.slug}#quote`}>
            {service.cta.button}
            <Icon name="arrow" />
          </a>
        </p>
      </aside>
    </div>
  </section>

  <section class="section section--concrete">
    <div class="wrap">
      <div class="detail-cols">
        <div data-reveal>
          <h3>Who needs it</h3>
          <ul class="dashes">
            {service.clients.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div data-reveal style="--delay:.08s">
          <h3>Problems it addresses</h3>
          <ul class="dashes">
            {service.problems.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div data-reveal style="--delay:.16s">
          <h3>Typical applications</h3>
          <ul class="dashes">
            {service.applications.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--navy">
    <div class="wrap grid-2">
      <div data-reveal>
        <p class="label">Why R. Kissoon</p>
        <h2>What we bring to this work.</h2>
        <ul class="ticks" style="margin-top:2rem">
          {service.value.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <figure class="frame" data-reveal style="--delay:.12s">
        <Picture
          name={service.secondaryImage ?? service.image}
          alt={service.secondaryImageAlt ?? service.imageAlt}
          sizes="(min-width: 900px) 45vw, 100vw"
        />
        <figcaption>Illustrative image. Not a photograph of a specific company project.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section" aria-labelledby="related-heading">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="label">Related projects</p>
        <h2 id="related-heading">From the documented portfolio.</h2>
      </div>
      {
        related.length > 0 ? (
          <>
            <div class="project-grid">
              {related.map((p) => (
                <div data-reveal>
                  <ProjectCard project={p} compact />
                </div>
              ))}
            </div>
            <p style="margin-top:2.5rem">
              <a class="text-link" href="/projects/">
                View all projects
                <Icon name="arrow" />
              </a>
            </p>
          </>
        ) : (
          <div class="empty-note" data-reveal>
            <p>
              No project records have been published for this service yet. Please <a href="/contact/#quote">contact us</a> to discuss your
              project.
            </p>
          </div>
        )
      }
    </div>
  </section>

  <section class="section section--concrete section--tight" aria-labelledby="other-heading">
    <div class="wrap">
      <p class="label">Other services</p>
      <h2 id="other-heading" class="sr-only">Other services</h2>
      <div class="other-services">
        {
          others.map((s) => (
            <a href={s.slug === 'equipment-rental' ? '/equipment-rental/' : `/services/${s.slug}/`}>
              <span>{s.number}</span>
              {s.title}
              <Icon name="arrow" />
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CTA heading={service.cta.heading} text={service.cta.text} button={service.cta.button} href={`/contact/?service=${service.slug}#quote`} />
</Base>
