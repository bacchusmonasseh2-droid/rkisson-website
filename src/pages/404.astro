---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Page not found" description="The page you were looking for could not be found on the R. Kissoon Contracting Service website." noindex>
  <PageHero label="Error 404" title="That page could not be found." lead="The address may have changed, or the link may be out of date.">
    <p style="margin-top:2rem;display:flex;flex-wrap:wrap;gap:.9rem">
      <a class="btn btn--primary" href="/">
        Go to the home page
        <Icon name="arrow" />
      </a>
      <a class="btn btn--ghost" href="/services/">View services</a>
    </p>
  </PageHero>
</Base>
